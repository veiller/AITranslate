<Window x:Class="AITranslate.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:AITranslate.WPF.ViewModels"
        Title="AITranslate - MOD 语言文件翻译" Height="760" Width="1160"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Padding="10,8" Background="{DynamicResource RegionBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Content="添加文件" Command="{Binding AddFilesCommand}" Margin="0,0,8,0" />
                <Button Content="添加文件夹" Command="{Binding AddFolderCommand}" Margin="0,0,16,0" />

                <Border Width="1" Margin="0,2,16,2" Background="{DynamicResource BorderBrush}" />

                <Button Content="开始翻译" Command="{Binding StartAllCommand}" Margin="0,0,8,0" Style="{StaticResource ButtonPrimary}" />
                <Button Content="停止" Command="{Binding StopAllCommand}" Margin="0,0,16,0" />

                <Border Width="1" Margin="0,2,16,2" Background="{DynamicResource BorderBrush}" />

                <Button Content="清空已完成" Command="{Binding ClearFinishedCommand}" Margin="0,0,8,0" />
                <Button Content="设置" Command="{Binding OpenSettingsCommand}" Margin="0,0,16,0" />

                <Border Width="1" Margin="0,2,16,2" Background="{DynamicResource BorderBrush}" />

                <TextBlock VerticalAlignment="Center" Foreground="#FF8C8C8C">
                    <Run Text="翻译目标：" />
                    <Run Text="{Binding GameDisplayName, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FF1890FF" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 空态 -->
        <Border Grid.Row="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasTabs}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🗂" FontSize="56" HorizontalAlignment="Center" Opacity="0.5" />
                <TextBlock Text="{Binding EmptyHint}" FontSize="18" Margin="0,16,0,6" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DropHint}" Foreground="#FF8C8C8C" HorizontalAlignment="Center" />
                <Button Content="或点击选择文件" Command="{Binding AddFilesCommand}" Margin="0,20,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 多页签 -->
        <TabControl Grid.Row="1"
                    x:Name="MainTabs"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}"
                    ItemContainerStyle="{StaticResource AppTabItemStyle}"
                    Margin="8,8,8,0">
            <TabControl.Style>
                <Style TargetType="TabControl">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasTabs}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Style>

            <!-- 页签头 -->
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}">
                        <hc:LoadingCircle Width="14" Height="14" Margin="0,0,6,0"
                                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TranslateState.Running}">
                                            <Setter Property="Fill" Value="#FF1890FF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TranslateState.Completed}">
                                            <Setter Property="Fill" Value="#FF52C41A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TranslateState.Failed}">
                                            <Setter Property="Fill" Value="#FFF5222D" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TranslateState.Canceled}">
                                            <Setter Property="Fill" Value="#FFFAAD14" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
                        <Button Margin="8,0,0,0" Padding="4,0" Height="18" BorderThickness="0" Background="Transparent"
                                Content="✕" FontSize="11"
                                ToolTip="关闭页签"
                                Command="{Binding DataContext.RemoveTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <!-- 页签内容 -->
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 文件与参数 -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="输出文件" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />

                            <!-- 参考文件：仅 BG3 需要（XCOM2 无复用概念） -->
                            <StackPanel Visibility="{Binding SupportsReferenceFile, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="参考文件（可选，仅 XML 复用其中已有的翻译）" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ReferencePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" VerticalAlignment="Top"
                                            Command="{Binding DataContext.PickReferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="翻译本文件" Margin="0,0,8,0"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Command="{Binding DataContext.StartTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ButtonPrimary}" />
                                <Button Content="取消" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
                                <Button Content="打开输出目录" Margin="0,0,8,0" Command="{Binding OpenOutputFolderCommand}" />
                                <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Bold" />
                            </StackPanel>

                            <ProgressBar Height="14" Maximum="100" Value="{Binding Percent}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- 流式预览 -->
                        <Border Grid.Row="1" Margin="0,10,0,0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="流式输出预览" FontWeight="Bold" Margin="8,6,0,4" />
                                <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         FontFamily="Consolas"
                                         BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextChanged="PreviewBox_TextChanged" />
                            </DockPanel>
                        </Border>

                        <!-- 日志 -->
                        <Expander Grid.Row="2" Header="日志" Margin="0,10,0,0" IsExpanded="False" MaxHeight="200">
                            <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12" />
                        </Expander>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="进行中 " />
                    <TextBlock Text="{Binding ActiveCount}" FontWeight="Bold" />
                    <TextBlock Text="  ｜  已完成 " />
                    <TextBlock Text="{Binding CompletedCount}" FontWeight="Bold" />
                    <TextBlock Text="  ｜  " />
                    <TextBlock Text="{Binding SettingsSummary}" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
