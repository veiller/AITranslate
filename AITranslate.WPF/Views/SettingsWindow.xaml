<hc:Window x:Class="AITranslate.WPF.Views.SettingsWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="设置" Width="580" Height="760"
           WindowStartupLocation="CenterOwner"
           ResizeMode="CanResize"
           ShowInTaskbar="False"
           MinWidth="480" MinHeight="520">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8C8C8C" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Required" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF5222D" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="设置" FontSize="18" FontWeight="Bold" />
            <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                       Text="先选要翻译的游戏，再填 AI 接口参数。" />
        </StackPanel>

        <!-- 表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 翻译目标 -->
                <TextBlock Text="翻译目标" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Games}"
                          SelectedItem="{Binding SelectedGame}"
                          DisplayMemberPath="DisplayName"
                          Padding="8,6" />
                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding GameHint}" />

                <Border Height="1" Background="#FFE8E8E8" Margin="0,18,0,18" />

                <TextBlock Text="AI 接口" FontWeight="Bold" Margin="0,0,0,10" />

                <!-- BaseUrl -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="接口地址" Style="{StaticResource FieldLabel}" Margin="0" />
                    <TextBlock Text="必填" Style="{StaticResource Required}" Margin="6,0,0,0" />
                </StackPanel>
                <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" Padding="8,6" />
                <TextBlock Style="{StaticResource FieldHint}">
                    填到版本号为止即可，<Run FontFamily="Consolas">/chat/completions</Run> 由程序自动补全。<LineBreak />
                    例：<Run FontFamily="Consolas">https://api.deepseek.com/v1</Run>
                </TextBlock>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0" TextWrapping="Wrap">
                    <Run Text="实际请求：" /><Run Text="{Binding FullUrl, Mode=OneWay}" FontFamily="Consolas" Foreground="#FF1890FF" />
                </TextBlock>

                <Border Height="1" Background="#FFE8E8E8" Margin="0,18,0,18" />

                <!-- ApiKey -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="API 密钥" Style="{StaticResource FieldLabel}" Margin="0" />
                    <TextBlock Text="必填" Style="{StaticResource Required}" Margin="6,0,0,0" />
                </StackPanel>
                <PasswordBox x:Name="ApiKeyBox" Padding="8,6" FontFamily="Consolas"
                             PasswordChanged="ApiKeyBox_PasswordChanged" />
                <TextBlock Style="{StaticResource FieldHint}">
                    在服务商控制台创建，通常以 <Run FontFamily="Consolas">sk-</Run> 开头。<LineBreak />
                    例：<Run FontFamily="Consolas">sk-1234567890abcdef</Run>
                </TextBlock>

                <Border Height="1" Background="#FFE8E8E8" Margin="0,18,0,18" />

                <!-- Model -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="模型名称" Style="{StaticResource FieldLabel}" Margin="0" />
                    <TextBlock Text="必填" Style="{StaticResource Required}" Margin="6,0,0,0" />
                </StackPanel>
                <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" Padding="8,6" />
                <TextBlock Style="{StaticResource FieldHint}">
                    填服务商文档里的模型 ID，需与上面的接口地址配套。<LineBreak />
                    例：<Run FontFamily="Consolas">deepseek-chat</Run>、
                    <Run FontFamily="Consolas">gpt-4o-mini</Run>、
                    <Run FontFamily="Consolas">moonshot-v1-8k</Run>
                </TextBlock>

            </StackPanel>
        </ScrollViewer>

        <!-- 测试结果 -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="10,8" CornerRadius="4"
                Background="#FFF7F7F7" BorderBrush="#FFE8E8E8" BorderThickness="1">
            <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" MinHeight="20" />
        </Border>

        <!-- 底部按钮 -->
        <Grid Grid.Row="3" x:Name="ButtonRow" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="测试连接" Width="110" Height="34"
                    Command="{Binding TestCommand}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="取消" Width="90" Height="34" Margin="0,0,12,0" Click="Cancel_Click" />
                <Button Content="保存" Width="90" Height="34" Click="Save_Click"
                        IsEnabled="{Binding CanSave}" Style="{StaticResource ButtonPrimary}" />
            </StackPanel>
        </Grid>
    </Grid>
</hc:Window>
